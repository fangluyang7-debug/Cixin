[Unit]
Description=Cixin board fleet runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cixin
WorkingDirectory=/opt/cixin-agent
EnvironmentFile=/etc/cixin-agent.env
ExecStart=/usr/bin/node /opt/cixin-agent/dist/cli.js /etc/cixin-agent.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
