# Current HarmonyOS shopping-assistant local configuration
# Copy this file to .env, then fill only the provider fields you need.

NODE_ENV=development

# Model search proxy
# The HarmonyOS app calls the local proxy; the proxy reads the real key from .env.
MODEL_SEARCH_PROXY_PORT=3010
MODEL_SEARCH_PROVIDER=openai_compatible
MODEL_SEARCH_BASE_URL=https://api.example.com/v1
MODEL_SEARCH_MODEL=your-model-name
MODEL_SEARCH_API_KEY=your-api-key
MODEL_SEARCH_TIMEOUT_MS=12000

# Optional fallback names for old code or alternate provider wiring.
CHAT_MODEL_BASE_URL=
CHAT_MODEL_NAME=
CHAT_MODEL_API_KEY=

# HarmonyOS app data source
APP_PRODUCT_SOURCE=rawfile_local_database
APP_SEARCH_EXECUTION=scheduler_then_local_database
