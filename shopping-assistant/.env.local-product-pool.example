# Copy .env.example to .env first, then use these overrides for local
# frontend/backend debugging against the imported product pool.

API_SERVER_PORT=3000
API_JSON_BODY_LIMIT=10mb
DATABASE_URL=file:./dev.db

SEARCH_PROVIDER=local_product_pool
PRODUCT_DATA_PROVIDER=local_product_pool

MODEL_PROVIDER=mock
VISION_PROVIDER=mock
CHAT_PROVIDER=mock

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=hash-image-text-512
EMBEDDING_DIMENSION=512
ANN_PROVIDER=sqlite_vec
ANN_TOP_K=50
ANN_MIN_SCORE=0.72

OBJECT_STORAGE_PROVIDER=mock
PRODUCT_IMAGE_BUCKET_GROUP=demo-assets
